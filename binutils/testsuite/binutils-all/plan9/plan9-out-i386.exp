# Only run these tests for an i386 plan9 target.
if { ![istarget i*86-*-plan9*] } {
    return
}

set testdir "$srcdir/$subdir"
set fixture "$testdir/callmain.8"

# Test 1: objdump -f recognizes the file format.
send_log "Testing: objdump -f on callmain.8\n"
set got [binutils_run $OBJDUMP "-f $fixture"]

if { [regexp "plan9-out-i386" $got] } {
    pass "objdump -f recognizes plan9-out-i386 format"
} else {
    fail "objdump -f does not recognize plan9-out-i386 format"
    send_log "Output was: $got\n"
}

# Test 2: nm works and finds at least one symbol.
send_log "Testing: nm on callmain.8\n"
set got [binutils_run $NM "$fixture"]

if { [string length $got] > 0 && ![regexp "no symbols" $got]
     && ![regexp "File format not recognized" $got] } {
    pass "nm works on plan9-out-i386 object file"
} else {
    fail "nm failed on plan9-out-i386 object file"
    send_log "Output was: $got\n"
}

# Test 3: nm finds specific symbols (_callmain is the real 9front libc entry).
if { [regexp "_callmain" $got] } {
    pass "nm finds '_callmain' symbol in callmain.8"
} else {
    fail "nm does not find '_callmain' symbol in callmain.8"
    send_log "Output was: $got\n"
}

# -----------------------------------------------------------------------
# Tests for AGLOBL data placement (native Plan 9 compatibility).
#
# argv0.8 is a data-only object containing two AGLOBL declarations:
#   AGLOBL argv0, $4   (argv0 at DATA offset 0, size 4)
#   AGLOBL _tos,  $4   (_tos  at DATA offset 4, size 4)
#
# Native Plan 9's 8l places AGLOBL-declared symbols in the DATA segment
# (zero-initialized), not in BSS.  After the fix, generated objects must
# match that behaviour: argv0 and _tos appear as DATA symbols with distinct,
# non-overlapping addresses, and the .data section carries their space.
# -----------------------------------------------------------------------
set bss_fixture "$testdir/argv0.8"

# Test 4: objdump -f recognizes argv0.8 as plan9-out-i386.
send_log "Testing: objdump -f on argv0.8\n"
set got4 [binutils_run $OBJDUMP "-f $bss_fixture"]

if { [regexp "plan9-out-i386" $got4] } {
    pass "objdump -f recognizes argv0.8 as plan9-out-i386"
} else {
    fail "objdump -f does not recognize argv0.8 as plan9-out-i386"
    send_log "Output was: $got4\n"
}

# Test 5: nm finds both argv0 and _tos in argv0.8.
send_log "Testing: nm on argv0.8\n"
set gotnm [binutils_run $NM "$bss_fixture"]

if { [regexp "argv0" $gotnm] && [regexp "_tos" $gotnm] } {
    pass "nm finds 'argv0' and '_tos' in argv0.8"
} else {
    fail "nm does not find expected DATA symbols in argv0.8"
    send_log "Output was: $gotnm\n"
}

# Test 6: argv0 and _tos must have DIFFERENT addresses (non-overlapping DATA).
# nm output is "VALUE TYPE NAME"; parse the hex values for both symbols.
send_log "Testing: DATA symbols argv0 and _tos have distinct addresses\n"
set addr_argv0 -1
set addr_tos   -1

foreach line [split $gotnm "\n"] {
    if { [regexp {^([0-9a-fA-F]+)\s+[Dd]\s+argv0\s*$} $line -> v] } {
        scan $v %x addr_argv0
    }
    if { [regexp {^([0-9a-fA-F]+)\s+[Dd]\s+_tos\s*$} $line -> v] } {
        scan $v %x addr_tos
    }
}

if { $addr_argv0 >= 0 && $addr_tos >= 0 && $addr_argv0 != $addr_tos } {
    pass "DATA symbols argv0 and _tos have distinct non-overlapping addresses"
} elseif { $addr_argv0 < 0 || $addr_tos < 0 } {
    fail "DATA symbols argv0 and/or _tos not found as D-type (addr_argv0=$addr_argv0, addr_tos=$addr_tos)"
    send_log "nm output was:\n$gotnm\n"
} else {
    fail "DATA symbols argv0 and _tos have overlapping addresses (addr_argv0=$addr_argv0, addr_tos=$addr_tos)"
    send_log "nm output was:\n$gotnm\n"
}

# Test 7: the DATA section of argv0.8 must have non-zero size (>= 8 bytes).
send_log "Testing: objdump -h shows non-zero .data size in argv0.8\n"
set gotsec [binutils_run $OBJDUMP "-h $bss_fixture"]

# The .data line in objdump -h contains the size as the second hex field.
# Example: "  1 .data         00000008  00000000  00000000  00000034  2**2"
if { [regexp {\.data\s+([0-9a-fA-F]+)} $gotsec -> datasz]
     && [scan $datasz %x dataval] == 1 && $dataval >= 8 } {
    pass "argv0.8 .data section has correct non-zero size"
} else {
    fail "argv0.8 .data section has unexpected size"
    send_log "objdump -h output was:\n$gotsec\n"
}

# -----------------------------------------------------------------------
# Tests for native Plan 9 i386 executable (pw).
#
# pw is a small native 9front/Plan 9 i386 executable produced by 8l.
# Its header has magic 0x1eb (big-endian), a_text=0xda, a_data=0x24,
# a_syms=0x3ee (1006 bytes of Plan 9-format symbols).  The Plan 9
# symbol format uses (4-byte big-endian value, 1-byte type, name\0)
# entries, not a.out nlist.  Bugs fixed:
#   - section layout: data filepos was off by EXEC_BYTES_SIZE (32 bytes)
#   - slurp: Plan 9 native symbols were wrongly decoded as a.out nlist,
#     causing malloc() corruption for a_syms not divisible by 12
# -----------------------------------------------------------------------
set pw_fixture "$testdir/pw"

# Test 8: objdump -f recognises pw as plan9-i386.
send_log "Testing: objdump -f on pw\n"
set got12 [binutils_run $OBJDUMP "-f $pw_fixture"]

if { [regexp "plan9-i386" $got12] } {
    pass "objdump -f recognizes pw as plan9-i386"
} else {
    fail "objdump -f does not recognize pw as plan9-i386"
    send_log "Output was: $got12\n"
}

# Test 9: objdump -d pw must not say "wrong format" (detection succeeds
# and the text section is read and disassembled without crash).
send_log "Testing: objdump -d on pw does not print 'wrong format'\n"
set got13 [binutils_run $OBJDUMP "-d $pw_fixture"]

if { ![regexp -nocase "wrong format" $got13] && [string length $got13] > 0 } {
    pass "objdump -d on pw succeeds (no 'wrong format')"
} else {
    fail "objdump -d on pw printed 'wrong format' or produced no output"
    send_log "Output was: $got13\n"
}

# Test 10: nm pw must not crash and must list at least one known symbol.
# The Plan 9 symbol table in pw contains 'etext' (a text-segment symbol).
send_log "Testing: nm on pw finds 'etext' symbol\n"
set got14 [binutils_run $NM "$pw_fixture"]

if { [regexp "etext" $got14] } {
    pass "nm on pw finds 'etext' (Plan 9 native symbol table parsed correctly)"
} else {
    fail "nm on pw did not find 'etext' -- Plan 9 native symtab may be broken"
    send_log "Output was: $got14\n"
}

# Test 10a: objdump -h pw must show text section at VMA 0x1020 and
# data section at VMA 0x2000.
# pw header: a_text=0xda, a_data=0x24.  Plan 9 native kernel layout:
#   text VMA = TEXTADDR + EXEC_BYTES_SIZE = 0x1000 + 32 = 0x1020
#   data VMA = page_align(TEXTADDR + EXEC_BYTES_SIZE + a_text)
#            = (0x1000 + 0x20 + 0xda + 0xfff) & ~0xfff = 0x2000
# (Native Plan 9 a_text = pure code_size, header NOT counted in a_text.
# The kernel reads data from file offset EXEC_BYTES_SIZE + a_text.)
# The Plan 9 kernel maps data at the first 0x1000-aligned page boundary
# after text ends.  For any Plan 9 executable with a_text < 0xfe0
# (all practical small programs) this is always 0x2000.
# This verifies that our reader (some_plan9_object_p) overrides the
# generic N_TXTADDR/N_DATADDR formulas with Plan 9-correct VMAs, and
# that the linker script DATA_ALIGNMENT=ALIGN(SEGMENT_SIZE)=ALIGN(0x1000)
# gives the correct page-aligned data placement.
send_log "Testing: objdump -h pw shows .text at VMA 0x1020 and .data at VMA 0x2000\n"
set got_pw_hdr [binutils_run $OBJDUMP "-h $pw_fixture"]

if { [regexp {\.text[^\n]*0+1020} $got_pw_hdr] } {
    pass "objdump -h pw: .text section at VMA 0x1020 (correct Plan 9 text VMA)"
} else {
    fail "objdump -h pw: .text section NOT at VMA 0x1020 -- text VMA formula may be wrong"
    send_log "Output was: $got_pw_hdr\n"
}

if { [regexp {\.data[^\n]*2000} $got_pw_hdr] } {
    pass "objdump -h pw: .data section at VMA 0x2000 (correct Plan 9 page-aligned data VMA)"
} else {
    fail "objdump -h pw: .data section NOT at VMA 0x2000 -- data page-alignment formula may be wrong"
    send_log "Output was: $got_pw_hdr\n"
}

# -----------------------------------------------------------------------
# Tests for the real 9front libc callmain.8 (606 bytes from 9front libc.a).
#
# The real 9front callmain.8 uses the Plan 9 ATEXT convention: the stack
# frame (auto) size is stored in the ATEXT to.offset field (0x50 = 80)
# rather than as a separate ADJSP instruction.  The BFD backend must
# synthesise ADJSP from the ATEXT auto-size and then adjust all D_AUTO
# and D_PARAM addresses by +auto_size, matching 9front 8l span() semantics.
#
# Before the fix: first instruction was 8d 84 24 c0 ff ff ff
#   (lea -0x40(%esp),%eax — no stack allocation, wrong offset).
# After the fix:
#   0: 83 ec 50  sub $0x50,%esp          (ADJSP from ATEXT auto-size)
#   3: 8d 44 24 10  lea 0x10(%esp),%eax  (D_AUTO -0x40 + 0x50 = +0x10)
# -----------------------------------------------------------------------

# Test 11: disassembly of callmain.8 contains sub $0x50,%esp (83 ec 50).
# The ATEXT auto-size must be converted to ADJSP -> SUBL to allocate the frame.
send_log "Testing: callmain.8 _callmain prologue contains sub \$0x50,%esp\n"
set got15 [binutils_run $OBJDUMP "-d $fixture"]

if { [regexp {83\s+ec\s+50} $got15] } {
    pass "callmain.8 contains sub \$0x50,%esp (ATEXT auto-size synthesised correctly)"
} else {
    fail "callmain.8 missing sub \$0x50,%esp -- ATEXT auto-size not synthesised"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 12: sub must be the FIRST instruction of _callmain (at offset 0).
send_log "Testing: callmain.8 _callmain first instruction is sub (not lea)\n"
if { [regexp {0:\s+83\s+ec\s+50} $got15] } {
    pass "callmain.8 _callmain first instruction is sub \$0x50,%esp (not lea)"
} else {
    fail "callmain.8 _callmain first instruction is not sub \$0x50,%esp"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 13: D_AUTO offset adjustment: lea must use 0x10(%esp) not -0x40(%esp).
# D_AUTO offset -0x40 adjusted by auto_size 0x50 must produce +0x10.
# Bytes: 8d 44 24 10 = lea 0x10(%esp),%eax  (correct, with 8-bit displacement).
send_log "Testing: callmain.8 D_AUTO offset adjusted (lea 0x10(%esp), not -0x40(%esp))\n"
if { [regexp {8d\s+44\s+24\s+10} $got15] } {
    pass "callmain.8 D_AUTO -0x40 + auto_size 0x50 = 0x10 (correct lea 0x10(%esp))"
} else {
    fail "callmain.8 D_AUTO offset not adjusted -- lea 0x10(%esp) not found"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 14: disassembly must NOT contain the wrong lea with -0x40 offset.
# 8d 84 24 c0 ff ff ff = lea -0x40(%esp),%eax (unadjusted, wrong).
send_log "Testing: callmain.8 does not contain unadjusted lea -0x40(%esp)\n"
if { ![regexp {8d\s+84\s+24\s+c0\s+ff\s+ff\s+ff} $got15] } {
    pass "callmain.8 does not contain lea -0x40(%esp) (D_AUTO correctly adjusted)"
} else {
    fail "callmain.8 contains lea -0x40(%esp) -- D_AUTO offset was NOT adjusted"
    send_log "objdump -d output was:\n$got15\n"
}

# -----------------------------------------------------------------------
# Tests for correct D_PARAM adjustment (fn_ptr at 0x54, not 0x50).
#
# In the x86 calling convention, after CALL pushes the return address,
# the first function parameter (D_PARAM 0) is at old_SP+4, not old_SP.
# After sub $0x50,%esp, D_PARAM 0 must map to new_SP+0x54, not 0x50.
#
# The bug: D_PARAM offsets were adjusted by +auto_size only, placing the
# function pointer at [ESP+0x50] = the return-address slot (== 0 in the
# 9front startup JMP convention), causing _callmain to jump to pc=0.
#
# The fix: D_PARAM offsets are adjusted by +auto_size+4 to account for
# the 4-byte return address between old_SP and the first parameter.
#
# Expected: 8b 44 24 54  mov 0x54(%esp),%eax  (D_PARAM 0 fn_ptr at SP+0x54)
#           ff d0         call *%eax
# -----------------------------------------------------------------------

# Test 15: D_PARAM 0 (fn_ptr) must be at 0x54(%esp) after adjustment.
# Bytes: 8b 44 24 54 = mov 0x54(%esp),%eax  (D_PARAM 0 + 0x50 + 4 = 0x54).
send_log "Testing: callmain.8 D_PARAM 0 fn_ptr adjusted to 0x54(%esp)\n"
if { [regexp {8b\s+44\s+24\s+54} $got15] } {
    pass "callmain.8 D_PARAM 0 fn_ptr at 0x54(%esp) (D_PARAM 0 + auto_size + 4)"
} else {
    fail "callmain.8 D_PARAM 0 fn_ptr not at 0x54(%esp) -- D_PARAM offset wrong"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 16: the instruction at 0x54(%esp) must be immediately followed by
# call *%eax (ff d0), confirming it is the indirect call through fn_ptr.
# Bytes: 8b 44 24 54 ... ff d0 (two consecutive instructions).
send_log "Testing: callmain.8 mov 0x54(%esp),%eax immediately precedes call *%eax\n"
if { [regexp {8b\s+44\s+24\s+54[^\n]*\n[^\n]*ff\s+d0} $got15] } {
    pass "callmain.8 fn_ptr load (8b 44 24 54) immediately precedes call *%eax (ff d0)"
} else {
    fail "callmain.8 fn_ptr load is not immediately before call *%eax"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 17: the wrong slot (0x50, == return address) must NOT be used.
# 8b 44 24 50 = mov 0x50(%esp),%eax would read the return address (== 0),
# causing pc=0x0 crash on 9front when the startup JMPs (not CALLs) _callmain.
send_log "Testing: callmain.8 does not contain mov 0x50(%esp),%eax (wrong slot)\n"
if { ![regexp {8b\s+44\s+24\s+50} $got15] } {
    pass "callmain.8 does not contain mov 0x50(%esp),%eax (return-addr slot not used)"
} else {
    fail "callmain.8 contains mov 0x50(%esp),%eax -- fn_ptr still reads return addr slot"
    send_log "objdump -d output was:\n$got15\n"
}

# -----------------------------------------------------------------------
# Tests for argc/argv argument slots in _callmain.
#
# In the 9front _callmain ABI, after sub $0x50,%esp the stack slots are:
#   new_SP+0x10 = &tosenv (D_AUTO -0x40 + 0x50)
#   new_SP+0x54 = fn_ptr  (D_PARAM 0 + 0x50 + 4)
#   new_SP+0x58 = argc    (D_PARAM 4 + 0x50 + 4)
#   new_SP+0x5c = &argv   (D_PARAM 8 + 0x50 + 4)
#
# The native 9front reference binary pw contains (at offsets 0x17, 0x1e):
#   17: 8b 44 24 58  mov 0x58(%esp),%eax   <- argc
#   1e: 8d 44 24 5c  lea 0x5c(%esp),%eax   <- &argv[0]
#
# These slots must match the native 9front binary exactly.  Any deviation
# causes _callmain to pass wrong argc/argv to the user program.
# -----------------------------------------------------------------------

# Test 18: argc must be loaded from 0x58(%esp).
# Bytes: 8b 44 24 58 = mov 0x58(%esp),%eax
# D_PARAM 4 (argc) + auto_size 0x50 + 4 (return addr) = 0x58 ✓
send_log "Testing: callmain.8 argc loaded from 0x58(%esp)\n"
if { [regexp {8b\s+44\s+24\s+58} $got15] } {
    pass "callmain.8 argc loaded from 0x58(%esp) (D_PARAM 4 + auto_size 0x50 + 4)"
} else {
    fail "callmain.8 argc NOT loaded from 0x58(%esp) -- D_PARAM offset wrong"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 19: argv address must be computed as lea 0x5c(%esp),%eax.
# Bytes: 8d 44 24 5c = lea 0x5c(%esp),%eax
# D_PARAM 8 (argv) + auto_size 0x50 + 4 (return addr) = 0x5c ✓
send_log "Testing: callmain.8 argv address computed from 0x5c(%esp)\n"
if { [regexp {8d\s+44\s+24\s+5c} $got15] } {
    pass "callmain.8 argv address computed from 0x5c(%esp) (D_PARAM 8 + auto_size 0x50 + 4)"
} else {
    fail "callmain.8 argv address NOT at 0x5c(%esp) -- D_PARAM offset wrong"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 20: Verify the complete _callmain sequence matches native 9front pw.
# All five key stack-relative accesses must appear in the disassembly:
#   sub $0x50,%esp          (frame alloc from ATEXT auto-size)
#   lea 0x10(%esp),%eax     (tosenv = D_AUTO -0x40 + 0x50)
#   mov 0x58(%esp),%eax     (argc = D_PARAM 4 + 0x50 + 4)
#   lea 0x5c(%esp),%eax     (argv = D_PARAM 8 + 0x50 + 4)
#   mov 0x54(%esp),%eax     (fn_ptr = D_PARAM 0 + 0x50 + 4)
#   call *%eax              (indirect call through fn_ptr)
# This mirrors the native 9front pw _callmain byte-for-byte for these slots.
send_log "Testing: callmain.8 complete _callmain sequence matches native 9front pw\n"
set seq_ok 1
foreach {pat desc} {
    {83\s+ec\s+50}       "sub \$0x50,%esp (frame alloc)"
    {8d\s+44\s+24\s+10}  "lea 0x10(%esp),%eax (tosenv D_AUTO)"
    {8b\s+44\s+24\s+58}  "mov 0x58(%esp),%eax (argc D_PARAM 4)"
    {8d\s+44\s+24\s+5c}  "lea 0x5c(%esp),%eax (argv D_PARAM 8)"
    {8b\s+44\s+24\s+54}  "mov 0x54(%esp),%eax (fn_ptr D_PARAM 0)"
    {ff\s+d0}             "call *%eax"
} {
    if { ![regexp $pat $got15] } {
        send_log "  MISSING: $desc\n"
        set seq_ok 0
    }
}
if { $seq_ok } {
    pass "callmain.8 _callmain stack-frame sequence matches native 9front pw"
} else {
    fail "callmain.8 _callmain stack-frame sequence does not match native 9front pw"
    send_log "objdump -d output was:\n$got15\n"
}

# -----------------------------------------------------------------------
# Tests for OMAGIC (relocatable) plan9-i386 object files.
#
# When $bu-as assembles Plan 9 i386 assembly, it produces an OMAGIC (0x107)
# relocatable object.  In OMAGIC format the text section starts at VMA 0.
# Because a_entry=0 is within the text segment [0, text_size), the generic
# some_aout_object_p heuristic incorrectly sets EXEC_P.
#
# This caused ld to treat the input object as already-placed (pre-linked),
# so relocations were skipped and user symbols like 'main' ended up at wrong
# addresses (e.g. 0x20f8 in BSS instead of inside .text at 0x1020+offset),
# making indirect calls crash ("page fault 0x20f8 no instruction").
#
# After the fix: EXEC_P is cleared for any OMAGIC plan9-i386 object in
# plan9_i386_object_p, so the linker relocates it normally.
#
# The VMA fixup block in write_object_contents is also guarded by EXEC_P:
# it only applies to executables, not to relocatable objects, so text VMA
# stays at 0 for .o files.
#
# Fixture: reloc_test.o is a hand-crafted minimal OMAGIC plan9-i386 object
# with one text symbol "main" at VMA 0.  It exercises the EXEC_P reader fix.
# -----------------------------------------------------------------------
set reloc_fixture "$testdir/reloc_test.o"

# Test 21: objdump -f on reloc_test.o must recognize plan9-i386 format.
send_log "Testing: objdump -f on reloc_test.o recognizes format\n"
set got_reloc [binutils_run $OBJDUMP "-f $reloc_fixture"]

if { [regexp "plan9-i386" $got_reloc] } {
    pass "objdump -f recognizes reloc_test.o as plan9-i386"
} else {
    fail "objdump -f does not recognize reloc_test.o as plan9-i386"
    send_log "Output was: $got_reloc\n"
}

# Test 22: reloc_test.o must NOT have EXEC_P set.
# OMAGIC (relocatable) objects must not be treated as pre-linked executables.
# Before the fix, EXEC_P was set because a_entry=0 is within text [0, size),
# causing ld to skip relocations and place user symbols at wrong addresses.
send_log "Testing: reloc_test.o does not have EXEC_P (it is a relocatable object)\n"
if { ![regexp {EXEC_P} $got_reloc] } {
    pass "reloc_test.o does not have EXEC_P (OMAGIC relocatable correctly identified)"
} else {
    fail "reloc_test.o incorrectly has EXEC_P set -- linker will skip relocations"
    send_log "Output was: $got_reloc\n"
}

# Test 23: nm on reloc_test.o must find the 'main' symbol in .text.
send_log "Testing: nm on reloc_test.o finds 'main' in .text\n"
set got_nm_reloc [binutils_run $NM "$reloc_fixture"]

if { [regexp {[Tt]\s+main} $got_nm_reloc] } {
    pass "nm finds 'main' as a text symbol in reloc_test.o"
} else {
    fail "nm did not find 'main' as a text symbol in reloc_test.o"
    send_log "nm output was: $got_nm_reloc\n"
}

# -----------------------------------------------------------------------
# Tests for CALL/JMP to external symbol encoding (direct E8/E9 rel32).
#
# In Plan 9 assembler, "CALL sym(SB)" is a direct near-call (E8 rel32).
# Before the fix, p9_oclass() returned Ym for P9D_EXTERN/P9D_STATIC, so
# the instruction selector picked Zo_m (FF /2 = indirect call through
# absolute memory address), generating "call *0x10cd" instead of a direct
# "call <sym>".  The CPU then dereferenced address 0x10cd as a function
# pointer, reading the first 4 bytes of pwrite stub code (0x33b8...) and
# jumping there, causing "page fault 0x33b8".
#
# After the fix, p9_doasm() intercepts CALL/JMP with P9D_EXTERN/P9D_STATIC
# target before the Ym match and emits E8/E9 rel32 directly.
#
# Fixture: main9.8 contains a CALL to "_callmain" (an external symbol).
# The tail-call optimizer converts this to JMP (E9), not FF 15 (call *mem).
# -----------------------------------------------------------------------
set main9_fixture "$testdir/main9.8"
set got_main9 [binutils_run $OBJDUMP "-d $main9_fixture"]

# Test 24: disassembly of main9.8 must NOT contain "ff 15" (CALL *abs32).
# "ff 15 xx xx xx xx" = call *0xXXXXXX (indirect through absolute memory).
# This is the wrong encoding for CALL/JMP to external symbol in Plan 9.
# Before the fix: CALL _callmain(SB) generated FF 15 (indirect), not E8/E9.
send_log "Testing: main9.8 does not contain indirect call-through-memory (ff 15)\n"
if { ![regexp {ff\s*15} $got_main9] } {
    pass "main9.8 CALL to external symbol not encoded as indirect FF 15"
} else {
    fail "main9.8 contains 'ff 15' (indirect call-through-memory) -- CALL encoding wrong"
    send_log "objdump -d output was:\n$got_main9\n"
}

# Test 25: disassembly of main9.8 must contain "e9" (direct JMP rel32).
# main9.8 contains a CALL to _callmain as its last instruction.
# The tail-call optimizer converts this CALL to JMP (E9 rel32) to match
# Plan 9's native 8l behavior: 8l emits a fall-through for the last CALL
# in a function, which means no return address is pushed on the stack.
# Without this, _callmain's D_PARAM[0] reads argc=0 instead of the main
# function pointer, causing CALL *EAX = CALL 0 → crash at pc=0x1.
send_log "Testing: main9.8 CALL _callmain tail-call optimized to JMP (E9 rel32)\n"
if { [regexp {\se9\s} $got_main9] } {
    pass "main9.8 CALL _callmain tail-call optimized to direct JMP E9 rel32"
} else {
    fail "main9.8 CALL _callmain not tail-call optimized -- expected E9 JMP rel32"
    send_log "objdump -d output was:\n$got_main9\n"
}

# Test 26: callmain.8 must also not contain any ff 15 (all external CALLs direct).
# callmain.8 may call external libc symbols; none should use indirect FF 15.
send_log "Testing: callmain.8 does not contain indirect call-through-memory (ff 15)\n"
if { ![regexp {ff\s*15} $got15] } {
    pass "callmain.8 has no indirect call-through-memory encoding (ff 15 absent)"
} else {
    fail "callmain.8 contains 'ff 15' -- external CALL incorrectly encoded as indirect"
    send_log "objdump -d output was:\n$got15\n"
}

# -----------------------------------------------------------------------
# Tests 27-29: PC-relative CALL relocation addend correctness.
#
# For an x86 CALL rel32 ("E8 disp32"), the CPU computes the call target as:
#   target = (field_address + 4) + disp32
# The BFD linker with pcrel_offset=TRUE (our PC32 howto) stores:
#   disp32 = sym_VMA + addend - (sec_VMA + output_offset + r->address)
#           = sym_VMA + addend - field_VMA
# CPU target = field_VMA + 4 + disp32 = sym_VMA + addend + 4
# To land at sym_VMA we need addend = -4.
#
# Without the fix (addend=0, pcrel_offset=FALSE), the call landed at
# sym_VMA + r->address + 4 (off by the field's section offset), causing a
# fault at the wrong address.  With addend=-4 and pcrel_offset=TRUE, the
# call lands exactly at sym_VMA.
#
# Verify via "objdump -r": the PC32 reloc for the external CALL in main9.8
# must have an addend of -4, shown as "-0x4" in the objdump output.
# -----------------------------------------------------------------------
send_log "Testing: objdump -r on main9.8 shows a PC32 relocation for _callmain\n"
set got_reloc [binutils_run $OBJDUMP "-r $main9_fixture"]

# Test 27: objdump -r output must contain a PC32 (pc-relative) relocation.
if { [regexp -nocase {PC32|pc32|pcrel|R_386_PC32} $got_reloc] } {
    pass "main9.8 has a PC32 relocation for tail-call JMP _callmain"
} else {
    fail "main9.8 missing PC32 relocation for tail-call JMP _callmain"
    send_log "objdump -r output was:\n$got_reloc\n"
}

# Test 28: The PC32 reloc addend must be -4.
# An addend of 0 would cause the call to land 4 bytes into the target.
# objdump displays -4 as "-0x4", "-4", "0xfffffffc" (32-bit), or
# "0xfffffffffffffffc" (64-bit host); all contain the pattern "fffffffc".
if { [regexp -nocase -- {-0x4|-4\b|fffffffc} $got_reloc] } {
    pass "main9.8 PC32 reloc has correct addend -4 for E9 rel32 JMP"
} else {
    fail "main9.8 PC32 reloc missing addend -4 -- JMP would land 4 bytes past target"
    send_log "objdump -r output was:\n$got_reloc\n"
}

# -----------------------------------------------------------------------
# Tests 28a-28b: Exact JMP offset checks for main9.8.
#
# main9.8 encodes _main as:
#   0x00: mov %eax,_tos      (6 bytes: 89 05 + ABS32 field)
#   0x06: mov $main,%eax     (5 bytes: b8 + ABS32 field)
#   0x0b: push %eax          (1 byte: 50)
#   0x0c: push $0x0          (2 bytes: 6a 00)
#   0x0e: jmp _callmain      (5 bytes: e9 + PC32 field at 0x0f)
#
# The PC32 reloc displacement field is at offset 0x0f (E9 opcode + 1).
# The linker writes: disp32 = _callmain_VMA - 4 - field_VMA
# so CPU executes: field_VMA + 4 + disp32 = _callmain_VMA (correct).
#
# Checking the reloc is at 0x0f (not 0x0e) ensures the reloc targets
# the displacement field and not the opcode byte; if the reloc were at
# 0x0e the linker would overwrite the E9 opcode, producing a garbled JMP.
# -----------------------------------------------------------------------

# Test 28a: PC32 reloc in main9.8 must be at offset 0x0f (JMP displacement field).
# The pattern "0000000f" (8 hex digits) must precede the PC32 reloc type.
send_log "Testing: main9.8 PC32 reloc is at offset 0x0f (E9+1 displacement field)\n"
if { [regexp {0000000f.*PC32} $got_reloc] } {
    pass "main9.8 PC32 reloc at offset 0x0f (displacement field, not E9 opcode byte)"
} else {
    fail "main9.8 PC32 reloc not at expected offset 0x0f -- reloc may target wrong byte"
    send_log "objdump -r output was:\n$got_reloc\n"
}

# Test 28b: main9.8 disassembly must show the JMP at offset 0xe.
# The line "  e:.*e9" must appear in objdump -d output, confirming that
# offset 0x0e contains the E9 opcode (i.e. the JMP is the last instruction
# at exactly the expected position within _main's text).
send_log "Testing: main9.8 disassembly shows JMP at offset 0xe (last instruction)\n"
if { [regexp {\se:\s.*e9\s} $got_main9] || [regexp {0000000e:\s.*e9\s} $got_main9] } {
    pass "main9.8 JMP (E9) at offset 0xe -- tail-call at correct position"
} else {
    fail "main9.8 JMP not found at offset 0xe -- CALL not converted or wrong position"
    send_log "objdump -d output was:\n$got_main9\n"
}

# Test 29: The disassembly must NOT contain the bytes "ff e8" as a 2-byte
# sequence in the .text disassembly.  "ff e8" decodes as LJMPF *%eax which
# is an invalid far-jump instruction -- it indicates a missing instruction
# boundary (e.g., the last byte 0xff of a "push $-1" followed by the 0xe8
# CALL opcode is being mis-decoded as a single instruction).
# This test guards against the specific mis-encoding reported where
# "ff e8 5b 00 00 00" appeared at the write()->pwrite() call site.
send_log "Testing: main9.8 disassembly does not contain 'ff e8' (wrong CALL encoding)\n"
if { ![regexp {ff\s*e8} $got_main9] } {
    pass "main9.8 disassembly does not contain 'ff e8' (no LJMPF *%%eax)"
} else {
    fail "main9.8 disassembly contains 'ff e8' -- possible wrong CALL encoding"
    send_log "objdump -d output was:\n$got_main9\n"
}

# -----------------------------------------------------------------------
# Tests 30-35: PC32 relocation precision and call-target correctness.
#
# Background: The symptom in t04.exe was that the CALL inside write() (from
# write.8) called address 0x10f5 (inside main) instead of pwrite at 0x10ca.
# Root cause was pcrel_offset=FALSE in the PC32 howto, which produced:
#   disp32 = sym_VMA - 4 - section_VMA
#   CPU target = section_VMA + r->address + 4 + disp32 = sym_VMA + r->address
# With r->address=0x2b, target = pwrite_VMA + 0x2b = 0x10f5 (wrong).
#
# Fix: pcrel_offset=TRUE with addend=-4:
#   disp32 = sym_VMA - 4 - section_VMA - r->address
#   CPU target = section_VMA + r->address + 4 + disp32 = sym_VMA ✓
#
# callmain.8 has CALL exits (direct call to external symbol) at text offset
# 0x34 (E8 opcode) with disp32 field at offset 0x35.  This mirrors the
# write() → pwrite() scenario exactly.
#
# Tests below verify that:
#  - E8 is at the CALL site (direct-call opcode)
#  - PC32 reloc is at offset 0x35 (E8+1 = disp32 field, not the opcode)
#  - Addend is -4
#  - No ff 15 (indirect call through memory) or ff e8 wrong byte sequence
#
# Together these prove the CPU will compute: target = sym_VMA ✓
# -----------------------------------------------------------------------
send_log "Testing: callmain.8 CALL exits uses direct E8 at offset 0x34\n"
# $fixture is set to callmain.8 at the top of this file.
# got15 already holds the callmain.8 disassembly from test 14; reuse it.
set got_callmain_d $got15
set got_callmain_r [binutils_run $OBJDUMP "-r $fixture"]

# Test 30: callmain.8 disassembly shows E8 at offset 0x34 (CALL exits direct).
# The disassembly line must include both "34" (the offset) and "e8" (the opcode).
if { [regexp {34:.*e8} $got_callmain_d] } {
    pass "callmain.8 CALL exits encoded as direct E8 at offset 0x34"
} else {
    fail "callmain.8 missing direct E8 at offset 0x34 for CALL exits"
    send_log "objdump -d output was:\n$got_callmain_d\n"
}

# Test 31: callmain.8 PC32 reloc is at offset 0x35 (disp32 field = E8+1).
# This confirms that the reloc points to the 4-byte displacement field,
# NOT to the E8 opcode byte -- the critical requirement for correct linking.
# With pcrel_offset=TRUE the formula uses r->address to adjust; if r->address
# pointed to E8 (0x34) instead of the field (0x35), the result would be wrong.
if { [regexp {00000035.*PC32} $got_callmain_r] } {
    pass "callmain.8 PC32 reloc at offset 0x35 (disp32 field position)"
} else {
    fail "callmain.8 PC32 reloc not at expected offset 0x35"
    send_log "objdump -r output was:\n$got_callmain_r\n"
}

# Test 32: callmain.8 PC32 reloc addend is -4.
# With pcrel_offset=TRUE and addend=-4:
#   CPU target = sym_VMA + addend + 4 = sym_VMA ✓
# Without addend=-4 (e.g., addend=0): target = sym_VMA + 4 (wrong).
if { [regexp -nocase -- {-0x4|-4\b|fffffffc} $got_callmain_r] } {
    pass "callmain.8 PC32 reloc has correct addend -4"
} else {
    fail "callmain.8 PC32 reloc missing addend -4 -- CALL target would be sym+4"
    send_log "objdump -r output was:\n$got_callmain_r\n"
}

# Test 33: callmain.8 PC32 reloc refers to 'exits' (the external callee symbol).
if { [regexp {exits} $got_callmain_r] } {
    pass "callmain.8 PC32 reloc targets external symbol 'exits'"
} else {
    fail "callmain.8 PC32 reloc does not reference 'exits'"
    send_log "objdump -r output was:\n$got_callmain_r\n"
}

# Test 34: callmain.8 disassembly does NOT contain 'ff 15' (call *abs32).
# This is the wrong indirect-through-memory encoding that caused the 9front
# crash: the CPU would read 4 bytes at the callee's address as a pointer and
# jump to garbage.  Fixed by emitting E8/E9 rel32 for P9D_EXTERN calls.
if { ![regexp {ff\s*15} $got_callmain_d] } {
    pass "callmain.8 has no indirect call-through-memory encoding (ff 15 absent)"
} else {
    fail "callmain.8 contains 'ff 15' -- external CALL incorrectly indirect"
    send_log "objdump -d output was:\n$got_callmain_d\n"
}

# Test 35: callmain.8 disassembly does NOT contain 'ff e8'.
# 'ff e8' is the wrong byte sequence that would appear if the instruction
# boundary was off (e.g., PUSH $-1 followed by E8 CALL being mis-read as
# a single far-jump instruction).
if { ![regexp {ff\s*e8} $got_callmain_d] } {
    pass "callmain.8 has no 'ff e8' encoding (no wrong instruction boundary)"
} else {
    fail "callmain.8 contains 'ff e8' -- possible wrong instruction boundary"
    send_log "objdump -d output was:\n$got_callmain_d\n"
}

# -----------------------------------------------------------------------
# Tests 36-41: Conditional branch (JEQ/JCC) encoding in exits.8
#
# exits.8 is the real 9front exits() from libc/port/exits.c:
#   TEXT exits+0(SB),$8         ; auto_size=8 → synthesised ADJSP
#   MOVL _onexit+0(SB),CX       ; load atexit function pointer
#   CMPL CX,$0                  ; is _onexit set?
#   JEQ  skip                   ; D_BRANCH target = func-relative PC 5
#   CALL* CX                    ; call _onexit() only when != NULL
# skip:
#   <arg setup for _exits>
#   CALL _exits(SB)             ; call _exits(msg)
#   ...
#
# Root cause of the JEQ bug: plan9-out-i386 resolved branch targets by
# comparing progs_all[j].back (which stored a FILE-GLOBAL instruction
# counter) against the D_BRANCH.offset value from the .8 file.
# D_BRANCH.offset is a FUNCTION-RELATIVE index where ATEXT=0; using a
# file-global counter caused the comparison to always fail, so
# pcond_idx stayed -1 and the Zbr case emitted 0 bytes → JEQ dropped.
#
# Fix: reset global_plan9_pc=0 at each ATEXT so that progs[].back
# stores function-relative indices matching D_BRANCH.offset values.
#
# Expected encoding (auto_size=8, ADJSP present):
#   0: 83 ec 08             sub    $0x8,%esp       (synthesised ADJSP)
#   3: 8b 0d XX XX XX XX   mov    _onexit,%ecx     (reloc)
#   9: 83 f9 00             cmp    $0x0,%ecx
#   c: 74 XX               je     skip             (skip CALL* CX)
#   e: ff d1               call   *%ecx
# skip:
#  ...  e8 XX XX XX XX      call   _exits           (reloc)
# -----------------------------------------------------------------------
set exits_fixture "$testdir/exits.8"
set got_exits_d [binutils_run $OBJDUMP "-d $exits_fixture"]

send_log "Testing: exits.8 recognized as plan9-out-i386\n"
# Test 36: exits.8 format is recognized.
set got_exits_f [binutils_run $OBJDUMP "-f $exits_fixture"]
if { [regexp "plan9-out-i386" $got_exits_f] } {
    pass "exits.8 recognized as plan9-out-i386 format"
} else {
    fail "exits.8 not recognized as plan9-out-i386 format"
    send_log "Output was: $got_exits_f\n"
}

send_log "Testing: exits.8 contains 'je' conditional branch\n"
# Test 37: exits.8 disassembly must contain 'je' (conditional branch).
# Without the fix, JEQ is silently dropped and only CMPL + CALL* CX appear
# with no jump between them.  With the fix, 'je' appears between them.
if { [regexp {j[et]} $got_exits_d] } {
    pass "exits.8 disassembly contains 'je' conditional branch (JEQ encoded)"
} else {
    fail "exits.8 missing 'je' -- JEQ was silently dropped (branch resolution bug)"
    send_log "objdump -d output was:\n$got_exits_d\n"
}

send_log "Testing: exits.8 contains 'ff d1' CALL* CX\n"
# Test 38: exits.8 disassembly must contain 'ff d1' (indirect CALL via CX).
# This is CALL* CX = ff d1; it must be present AND preceded by a 'je'.
if { [regexp {ff\s*d1} $got_exits_d] } {
    pass "exits.8 disassembly contains 'ff d1' (CALL* CX)"
} else {
    fail "exits.8 missing 'ff d1' -- CALL* CX not encoded correctly"
    send_log "objdump -d output was:\n$got_exits_d\n"
}

send_log "Testing: exits.8 'je' appears at offset 9 before CALL* CX at offset b\n"
# Test 39: The short JE opcode byte (0x74) must appear in the disassembly.
# A long form (0f 84) would also be acceptable, but for exits (auto_size=0)
# the displacement is small so the short form is expected.
if { [regexp {74} $got_exits_d] || [regexp {0f\s*84} $got_exits_d] } {
    pass "exits.8 JEQ short/long form opcode (74 or 0f 84) found in disassembly"
} else {
    fail "exits.8 missing JEQ opcode (74 / 0f 84) in raw bytes"
    send_log "objdump -d output was:\n$got_exits_d\n"
}

send_log "Testing: exits.8 direct CALL _exits uses E8\n"
# Test 40: exits.8 disassembly must contain 'e8' (direct CALL _exits).
# The skip target is a direct CALL to _exits via E8 rel32.
if { [regexp {e8} $got_exits_d] } {
    pass "exits.8 CALL _exits encoded as direct E8"
} else {
    fail "exits.8 missing E8 -- CALL _exits not encoded as direct call"
    send_log "objdump -d output was:\n$got_exits_d\n"
}

send_log "Testing: exits.8 has no indirect call-through-memory (ff 15)\n"
# Test 41: exits.8 must NOT contain 'ff 15' (indirect call through abs32 memory).
# This encoding would mean an external CALL was wrongly turned into an
# indirect-through-memory call (the earlier Part I bug pattern).
if { ![regexp {ff\s*15} $got_exits_d] } {
    pass "exits.8 has no indirect call-through-memory (ff 15 absent)"
} else {
    fail "exits.8 contains 'ff 15' -- external CALL incorrectly indirect"
    send_log "objdump -d output was:\n$got_exits_d\n"
}

send_log "Testing: exits.8 does not have CMP immediately followed by CALL* (no JCC between them)\n"
# Test 42: exits.8 must NOT contain the broken byte sequence 83 f9 00 ff d1
# (CMPL CX,$0 followed immediately by CALL* CX with no conditional jump between them).
# This exact sequence is what gets emitted when the JEQ branch target resolution
# fails (back values don't match D_BRANCH.offset) and the JEQ instruction is
# silently dropped, leaving CMPL → CALL* with no guard.
# With the fix (function-relative back values reset to 0 at each ATEXT), the JEQ
# resolves correctly and 74 XX appears between 83 f9 00 and ff d1.
if { ![regexp {83\s*f9\s*00\s*ff\s*d1} $got_exits_d] } {
    pass "exits.8 no direct CMPL-then-CALL*CX (JCC correctly inserted)"
} else {
    fail "exits.8 broken: CMPL followed directly by CALL*CX (JEQ dropped -- D_BRANCH resolution bug)"
    send_log "objdump -d output was:\n$got_exits_d\n"
}

# -----------------------------------------------------------------------
# Tests for nm on a Plan 9 i386 executable (plan9-i386 / 0x1eb format).
#
# 'pw' is a real Plan 9 i386 executable containing symbols in the Plan 9
# inline symbol-stream format: each record is a 4-byte big-endian value,
# a 1-byte type (with 0x80 OR'd in), and a NUL-terminated name.
#
# Before the fix, nm produced no output (or "File in wrong format") because:
#   1. slurp_symbol_table contained a hardcoded seek to a wrong file offset
#      (0x20ec) left over from debugging, instead of using obj_sym_filepos.
#   2. An incorrect external_nlist branch was present (dead code after REAPPLY).
#   3. A wrong n%12 shortcut misidentified variable-length streams as
#      fixed 12-byte records.
#
# After the fix all three issues are corrected and nm reads symbols correctly.
# -----------------------------------------------------------------------
set exec_fixture "$testdir/pw"

# Test 43: nm on the Plan 9 executable does not report "wrong format".
send_log "Testing: nm on Plan 9 i386 executable pw\n"
set got_nm_exec [binutils_run $NM "$exec_fixture"]

if { [string length $got_nm_exec] > 0
     && ![regexp "File format not recognized" $got_nm_exec]
     && ![regexp "File in wrong format" $got_nm_exec]
     && ![regexp "no symbols" $got_nm_exec] } {
    pass "nm reads symbols from Plan 9 i386 executable (pw)"
} else {
    fail "nm failed on Plan 9 i386 executable (pw)"
    send_log "Output was: $got_nm_exec\n"
}

# Test 44: nm finds 'main' (text symbol) in the executable.
if { [regexp {main} $got_nm_exec] } {
    pass "nm finds 'main' symbol in Plan 9 executable"
} else {
    fail "nm does not find 'main' symbol in Plan 9 executable"
    send_log "Output was: $got_nm_exec\n"
}

# Test 45: nm finds '_callmain' in the executable.
if { [regexp {_callmain} $got_nm_exec] } {
    pass "nm finds '_callmain' symbol in Plan 9 executable"
} else {
    fail "nm does not find '_callmain' symbol in Plan 9 executable"
    send_log "Output was: $got_nm_exec\n"
}

# Test 46: nm finds 'etext' (global text boundary symbol) in the executable.
if { [regexp {etext} $got_nm_exec] } {
    pass "nm finds 'etext' symbol in Plan 9 executable"
} else {
    fail "nm does not find 'etext' symbol in Plan 9 executable"
    send_log "Output was: $got_nm_exec\n"
}

# -----------------------------------------------------------------------
# Tests 47-50: Verify callmain.8 ADJSP auto-size and _callmain stack layout.
#
# _callmain has TEXT autosize=0x50 (80 bytes).  The BFD Plan 9 backend
# synthesises a 'sub $0x50,%esp' (83 ec 50) at function entry.
#
# With JMP (not CALL) from _main:
#   Before sub: [esp+0] = $0, [esp+4] = main_ptr, [esp+8..] = kernel args
#   After sub $0x50:
#     [esp+0x50] = $0
#     [esp+0x54] = main_ptr  ← D_PARAM[0] → fn_ptr ✓
#     [esp+0x58] = argc      ← D_PARAM[4] ✓
#     [esp+0x5c] = argv      ← D_PARAM[8] ✓
#
# With CALL (the bug, now fixed):
#   Return addr pushed by CALL shifts stack by 4:
#     [esp+0x54] = $0 = 0    ← fn_ptr reads 0 → CALL *EAX = CALL 0 → pc=0x1
#
# These tests verify that:
#   47. callmain.8 contains 'sub $0x50,%esp' (83 ec 50) — ADJSP synthesised
#   48. callmain.8 contains 'mov 0x54(%esp),%e' — fn_ptr read at +0x54
#   49. callmain.8 does NOT contain 'mov 0x50(%esp),%e' — NOT 0x50 (would be
#       the wrong offset if CALL had been used instead of JMP)
#   50. callmain.8 contains 'call *%e' (ff d0/d1/d2) — indirect call for main()
# -----------------------------------------------------------------------

# Test 47: callmain.8 synthesised ADJSP gives 'sub $0x50,%esp' (83 ec 50).
send_log "Testing: callmain.8 has synthesised 'sub \$0x50,%%esp' (83 ec 50)\n"
if { [regexp {83\s*ec\s*50} $got15] } {
    pass "callmain.8 ADJSP synthesised as 'sub \$0x50,%%esp' (83 ec 50)"
} else {
    fail "callmain.8 missing ADJSP 'sub \$0x50,%%esp' -- autosize 0x50 not synthesised"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 48: callmain.8 loads fn_ptr from 0x54(%esp) — the D_PARAM[0] offset
# for autosize 0x50 is 0 + 0x50 + 4 = 0x54.  With CALL instead of JMP,
# [esp+0x54] would hold $0 (=0) and CALL *EAX would crash at pc=0x1.
send_log "Testing: callmain.8 reads fn_ptr from 0x54(%%esp) (D_PARAM\[0\] with autosize 0x50)\n"
if { [regexp {0x54\(.*esp\)} $got15] } {
    pass "callmain.8 reads fn_ptr from 0x54(%%esp) -- correct D_PARAM\[0\] offset"
} else {
    fail "callmain.8 missing '0x54(%%esp)' load -- D_PARAM\[0\] offset wrong or missing"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 49: callmain.8 must NOT load fn_ptr from 0x50(%esp).
# With CALL (buggy), the shifted stack would put $0 at [esp+0x54] and
# main_ptr at [esp+0x58], but _callmain still reads from [esp+0x54] → $0 → crash.
# 0x50(%esp) is where $0 lands with JMP; that should be read as argc-like slot
# by _callmain only if main9.s had pushed a different value.  The absence of
# '0x50(%%esp)' in function-pointer context confirms the layout is correct.
# (callmain.8 may have 0x50 as part of the ADJSP immediate, not as a load,
# so we just ensure the 0x50(%esp) addressing mode doesn't appear as a load.)
send_log "Testing: callmain.8 does not load from 0x50(%%esp) (would be wrong if CALL used)\n"
if { ![regexp {0x50\(.*esp\)} $got15] } {
    pass "callmain.8 does not load from 0x50(%%esp) (stack layout correct for JMP)"
} else {
    fail "callmain.8 loads from 0x50(%%esp) -- potential stack layout mismatch (CALL vs JMP?)"
    send_log "objdump -d output was:\n$got15\n"
}

# Test 50: callmain.8 must contain an indirect call (ff d0/d1/d2) to invoke main().
send_log "Testing: callmain.8 has indirect call 'ff d\[012\]' to invoke main()\n"
if { [regexp {ff\s*d[012]} $got15] } {
    pass "callmain.8 has indirect CALL *reg to invoke main() function pointer"
} else {
    fail "callmain.8 missing indirect call -- main() function pointer not called"
    send_log "objdump -d output was:\n$got15\n"
}


# -----------------------------------------------------------------------
# Tests 51-54: CALL→JMP conversion narrowing (startup pattern guard).
#
# The CALL→JMP tail-call conversion must ONLY fire for the Plan 9 startup
# pattern: a function with auto_size==0 whose last instruction is preceded
# by PUSHL $0 (the fake return address _main pushes for _callmain).
#
# Without this guard, functions like write() that end with CALL pwrite()
# (the last instruction before AEND in the object file) would be wrongly
# converted to JMP pwrite().  That JMP omits the CPU's automatic return-
# address push, so pwrite()'s RET pops the fd argument (value 1) as the
# return address, sending PC to 0x1 → "fault read addr=0x1 pc=0x1" on
# native Plan 9.
#
# Test 51: main9.8 must contain "6a 00" at offset 0x0c.
# 6a 00 = PUSH $0x0 (the fake return address that enables the JMP conversion
# for the _main→_callmain startup tail-call).
send_log "Testing: main9.8 has 'push \$0x0' (6a 00) at offset 0x0c (startup fake retaddr)\n"
set got_main9_d [binutils_run $OBJDUMP "-d $main9_fixture"]
if { [regexp {\sc:\s+6a\s+00\s} $got_main9_d] || [regexp {0x0c:\s+6a\s+00} $got_main9_d] } {
    pass "main9.8 has 'push \$0x0' (6a 00) at offset 0x0c -- startup fake return address present"
} else {
    fail "main9.8 missing 'push \$0x0' (6a 00) at offset 0x0c -- startup pattern broken"
    send_log "objdump -d output was:\n$got_main9_d\n"
}

# Test 52: main9.8 must contain "push %eax" (50) at offset 0x0b.
# This pushes the main() function pointer before the fake $0 return address.
send_log "Testing: main9.8 has 'push %%eax' (50) at offset 0x0b (main() function pointer)\n"
if { [regexp {\sb:\s+50\s} $got_main9_d] || [regexp {0x0b:\s+50\s} $got_main9_d] } {
    pass "main9.8 has 'push %%eax' (50) at offset 0x0b -- main() fn-ptr pushed before fake retaddr"
} else {
    fail "main9.8 missing 'push %%eax' (50) at offset 0x0b -- startup pattern wrong"
    send_log "objdump -d output was:\n$got_main9_d\n"
}

# -----------------------------------------------------------------------
# Tests 53-54: write_stub.8 -- a function ending with CALL (not JMP).
#
# write_stub.8 is a synthetic Plan 9 .8 file with:
#   TEXT write+0(SB), $0    ; auto_size=0 (same as _main)
#   PUSHL AX                ; push fd register (NOT PUSHL $0!)
#   CALL pwrite(SB)         ; last instruction in the file (before AEND)
#
# The CALL pwrite is the last instruction (next entry is AEND = end-of-file),
# identical to how _main ends with CALL _callmain.  But because the preceding
# instruction is PUSHL AX (not PUSHL $0), the startup pattern guard must
# prevent the CALL→JMP conversion.
# -----------------------------------------------------------------------
set write_stub_fixture "$testdir/write_stub.8"
set got_write_stub [binutils_run $OBJDUMP "-d $write_stub_fixture"]

# Test 53: write_stub.8 must be recognised as plan9-out-i386.
send_log "Testing: objdump -f recognizes write_stub.8 as plan9-out-i386\n"
set got_ws_fmt [binutils_run $OBJDUMP "-f $write_stub_fixture"]
if { [regexp -nocase {plan9-out-i386|plan9.*i386|i386.*plan9} $got_ws_fmt] } {
    pass "objdump -f recognizes write_stub.8 as plan9-out-i386"
} else {
    fail "objdump -f does not recognize write_stub.8 as plan9-out-i386"
    send_log "objdump -f output was:\n$got_ws_fmt\n"
}

# Test 54: write_stub.8 CALL pwrite must be encoded as E8 (direct CALL), NOT E9 (JMP).
# The preceding PUSHL AX (not PUSHL $0) disqualifies the startup-pattern guard,
# so the CALL must remain a CALL even though it is the last instruction in the file.
# If this test fails, the CALL→JMP conversion is too aggressive and would produce
# the "fault read addr=0x1 pc=0x1" crash on native Plan 9.
send_log "Testing: write_stub.8 CALL pwrite stays as E8 (not E9) -- no spurious CALL→JMP\n"
if { [regexp {\se8\s} $got_write_stub] && ![regexp {\se9\s} $got_write_stub] } {
    pass "write_stub.8 CALL pwrite encoded as E8 (not E9) -- startup guard correct"
} else {
    fail "write_stub.8 CALL pwrite wrong encoding (expected E8 CALL, not E9 JMP)"
    send_log "objdump -d output was:\n$got_write_stub\n"
}

# Test 55: exits.8 must have epilogue 'add $0x8,%esp' (83 c4 08) before 'ret' (c3).
# Plan 9 8l implicitly generates "ADD $frame_size,%esp; RET" as the function epilogue
# for any function with auto_size > 0.  Without the ADD, the RET pops a stale stack
# argument as the return address, causing a crash.
# exits.8 has auto_size=8, so the epilogue must include 83 c4 08 followed by c3.
send_log "Testing: exits.8 has epilogue 'add \$0x8,%%esp' (83 c4 08) before ret\n"
if { [regexp {83\s+c4\s+08} $got_exits_d] } {
    pass "exits.8 has epilogue 'add \$0x8,%%esp' (83 c4 08) -- stack restored before ret"
} else {
    fail "exits.8 missing epilogue 'add \$0x8,%%esp' -- stack not restored before ret"
    send_log "objdump -d output was:\n$got_exits_d\n"
}

# Test 56: callmain.8 must have epilogue 'add $0x50,%esp' (83 c4 50) before 'ret' (c3).
# _callmain has auto_size=0x50 (80 bytes).  The epilogue restores the frame before
# returning.  Without it the RET would pop a wrong value as the return address.
send_log "Testing: callmain.8 has epilogue 'add \$0x50,%%esp' (83 c4 50) before ret\n"
if { [regexp {83\s+c4\s+50} $got15] } {
    pass "callmain.8 has epilogue 'add \$0x50,%%esp' (83 c4 50) -- stack restored before ret"
} else {
    fail "callmain.8 missing epilogue 'add \$0x50,%%esp' -- stack not restored before ret"
    send_log "objdump -d output was:\n$got15\n"
}
